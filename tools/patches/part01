+void SmartDenoiseEngine::clearProfileDisplay() noexcept
+{
+    for (auto& value : profileDisplayDb)
+        value.store (-120.0f, std::memory_order_relaxed);
+}
+
+void SmartDenoiseEngine::publishProfileDisplay() noexcept
+{
+    if (! profileValid.load (std::memory_order_acquire)
+        || profileFftSize <= 0)
+    {
+        clearProfileDisplay();
+        return;
+    }
+
+    const int bins = profileFftSize / 2 + 1;
+
+    for (int band = 0; band < profileDisplayBandCount; ++band)
+    {
+        const float startNorm =
+            static_cast<float> (band)
+            / static_cast<float> (profileDisplayBandCount);
+        const float endNorm =
+            static_cast<float> (band + 1)
+            / static_cast<float> (profileDisplayBandCount);
+
+        const int startBin = juce::jlimit (
+            1, bins - 1,
+            1 + static_cast<int> (
+                startNorm * startNorm
+                * static_cast<float> (bins - 2)));
+
+        const int endBin = juce::jlimit (
+            startBin + 1, bins,
+            1 + static_cast<int> (
+                endNorm * endNorm
+                * static_cast<float> (bins - 2)));
+
+        double sum = 0.0;
+        int count = 0;
+
+        for (int bin = startBin; bin < endBin; ++bin)
+        {
+            sum += 0.5 * (
+                profilePower[0][static_cast<size_t> (bin)]
+                + profilePower[1][static_cast<size_t> (bin)]);
+            ++count;
+        }
+
+        const float meanPower =
+            count > 0
+            ? static_cast<float> (sum / static_cast<double> (count))
+            : kFloor;
+
+        const float db = juce::jlimit (
+            -120.0f, 0.0f,
+            powerRatioToDb (juce::jmax (meanPower, kFloor)));
+
+        profileDisplayDb[static_cast<size_t> (band)].store (
+            db, std::memory_order_relaxed);
+    }
+}
+
+void SmartDenoiseEngine::lockProfileForNonRealtime() const noexcept
+{
+    while (profileAccessGuard.test_and_set (std::memory_order_acquire))
+        std::this_thread::yield();
+}
+
+bool SmartDenoiseEngine::tryLockProfileForRealtime() const noexcept
+{
+    return ! profileAccessGuard.test_and_set (std::memory_order_acquire);
+}
+
+void SmartDenoiseEngine::unlockProfile() const noexcept
+{
+    profileAccessGuard.clear (std::memory_order_release);
+}
